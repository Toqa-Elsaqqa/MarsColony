@startuml class_diagram
title MARS-OPS - Full Merged Class Diagram
skinparam classAttributeIconSize 0

package Core {
  abstract class Agent {
    +canPerform(Skill) boolean
    +setAvailability(boolean) void
  }
  interface Location
  abstract class Facility {
    +amountOf(String) int
    +add(Resource) void
    +remove(String, int) boolean
    +getOperationalStatus() boolean
  }
  class Resource
  class Equipment
  enum Skill
  enum EquipmentType
  class MartianSurface
}
package Personnel {
  abstract class Human
  class Scientist
  class Engineer
  class MedicalOfficer
  class Firefighter
}
package Robots {
  abstract class Robot
  class ExplorationRover
  class RepairRobot
  class Drone
}
package Facilities {
  class Habitat
  class LifeSupportSystem
  class Lab
  class StorageFacility
  class PowerStation
  class CommunicationStation
}
package Colony {
  class MarsColony {
    +getTotalResource(String) int
    +hasResources(Map) boolean
    +consume(Map) boolean
    +submitMission(Mission) boolean
    +getActiveMission() Mission
  }
}
package Missions {
  abstract class Mission {
    +validateRequirements(MarsColony, Environment) boolean
    +markAssigned() void
    +start() void
    +step(MarsColony, Environment) void
    +complete(MarsColony) void
    +fail(String) void
  }
  class ExplorationMission
  class RepairMission
  class ResearchMission
  class RescueMission
  enum MissionState
}
package Environment {
  class Environment {
    +getWeatherCondition() WeatherCondition
    +setWeatherCondition(WeatherCondition) void
    +isDustStorm() boolean
    +isCommDisruption() boolean
  }
  enum WeatherCondition
}
package Simulation {
  class Simulation {
    +advanceTime(int) void
  }
}
package Emergencies {
  interface ColonyServices
  abstract class Emergency {
    +detect(ColonyServices) void
    +resolve(ColonyServices) void
    +fail(String, ColonyServices) void
  }
  class EmergencyHandler {
    +handle(Emergency) void
  }
  class OxygenLeak
  class Fire
  class RoverBreakdown
  class MedicalEmergency
  enum EmergencyState
}
package Reporting {
  class StatusReport
}

Agent <|-- Human
Agent <|-- Robot
Human <|-- Scientist
Human <|-- Engineer
Human <|-- MedicalOfficer
Human <|-- Firefighter
Robot <|-- ExplorationRover
Robot <|-- RepairRobot
Robot <|-- Drone
Facility <|-- Habitat
Facility <|-- Lab
Facility <|-- StorageFacility
Facility <|-- PowerStation
Facility <|-- CommunicationStation
Mission <|-- ExplorationMission
Mission <|-- RepairMission
Mission <|-- ResearchMission
Mission <|-- RescueMission
Emergency <|-- OxygenLeak
Emergency <|-- Fire
Emergency <|-- RoverBreakdown
Emergency <|-- MedicalEmergency
Location <|.. Facility
Location <|.. MartianSurface

MarsColony ..|> ColonyServices
MarsColony o-- "0..*" Human : crew
MarsColony o-- "0..*" Robot : robots
MarsColony o-- "0..*" Facility : facilities
MarsColony --> "0..1" Mission : activeMission
MarsColony --> "1" Environment
Habitat *-- "1" LifeSupportSystem : sys
Facility *-- "0..*" Resource : ledger
Facility o-- "0..*" Equipment : equipment
ExplorationRover o-- "0..*" Equipment : equipment
Mission --> "1..*" Agent : assignedAgents
Mission --> "0..1" Facility : targetFacility
Mission --> "0..1" Location : targetLocation
Simulation --> MarsColony
Simulation --> Environment
EmergencyHandler --> ColonyServices
EmergencyHandler o-- "0..*" Emergency : history
OxygenLeak --> Habitat
Fire --> Lab
RoverBreakdown --> ExplorationRover
MedicalEmergency --> Agent : patient
MedicalEmergency --> Facility : treatmentFacility
StatusReport ..> MarsColony
StatusReport ..> EmergencyHandler
Mission --> MissionState
Environment --> WeatherCondition
Emergency --> EmergencyState
@enduml
